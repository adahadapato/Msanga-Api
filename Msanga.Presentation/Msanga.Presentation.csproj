<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The web API: minimal-API endpoints, JWT sign-in, CORS, rate limits, errors, OpenAPI. The composition root. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4f1c9b62-3a7e-4d0b-9c58-1e6a2d7f8b30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msanga.Application\Msanga.Application.csproj" />
    <ProjectReference Include="..\Msanga.Persistence\Msanga.Persistence.csproj" />
    <ProjectReference Include="..\Msanga.Infrastructure\Msanga.Infrastructure.csproj" />
    <ProjectReference Include="..\Msanga.Worker\Msanga.Worker.csproj" />
  </ItemGroup>

</Project>

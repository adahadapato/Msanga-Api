{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/msanga-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Msanga.Api"
    }
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.msanga.app",
    "WebsiteBaseUrl": "https://msanga.app"
  },
  "OpenApi": {
    "Enabled": false,
    "Title": "Msanga API",
    "Version": "v1",
    "Description": "Msanga, the reunion app: accounts and members (M1). Sets, reunions and memories come next.",
    "DocumentPath": "/openapi/{documentName}.json",
    "UiPath": "swagger",
    "Contact": {
      "Name": "Enobong Adahada",
      "Email": "",
      "Url": "https://github.com/adahadapato"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Identity": {
    "Password": {
      "RequiredLength": 10,
      "RequireDigit": false,
      "RequireLowercase": false,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "AllowedForNewUsers": true
    },
    "Codes": {
      "ConfirmEmailMinutes": 30,
      "ResetPasswordMinutes": 15
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Msanga-API",
    "Audience": "Msanga-Apps",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Email": {
    "Enabled": false,
    "FromName": "Msanga",
    "FromAddress": "no-reply@msanga.app",
    "ReplyToAddress": "",
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "OutboxFolder": "App_Data/emails"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://msanga.app",
      "https://www.msanga.app"
    ]
  },
  "AllowedHosts": "*"
}
